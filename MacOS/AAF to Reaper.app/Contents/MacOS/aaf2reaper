#!/bin/bash
# AAF to Reaper - converts AAF files (DaVinci Resolve etc.) into REAPER projects.
HERE="$(cd "$(dirname "$0")/../Resources" && pwd)"
LOG="$HOME/Library/Logs/AAF to Reaper.log"
mkdir -p "$HOME/Library/Logs"

alert() {  # title, message
  /usr/bin/osascript - "$1" "$2" <<'OSA' >/dev/null 2>&1
on run argv
  display dialog (item 2 of argv) with title (item 1 of argv) buttons {"OK"} default button "OK" with icon caution
end run
OSA
}

# Find a working Python 3
PY=""
for c in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3; do
  if [ -x "$c" ] && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3,6) else 1)' >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  alert "AAF to Reaper" "Python 3 was not found. Open Terminal and run:  xcode-select --install   then try again."
  exit 1
fi

# Files passed on the command line, or ask with a file dialog
FILES=()
for a in "$@"; do case "$a" in -psn_*) ;; *) FILES+=("$a");; esac; done
if [ ${#FILES[@]} -eq 0 ]; then
  LIST=$(/usr/bin/osascript <<'OSA' 2>/dev/null
set fs to choose file with prompt "Choose AAF file(s) to convert to REAPER projects" of type {"aaf", "AAF"} with multiple selections allowed
set out to ""
repeat with f in fs
  set out to out & POSIX path of f & linefeed
end repeat
return out
OSA
)
  [ -z "$LIST" ] && exit 0
  while IFS= read -r line; do [ -n "$line" ] && FILES+=("$line"); done <<< "$LIST"
fi

echo "==== $(date) ====" >> "$LOG"
OUT=$("$PY" "$HERE/aaf2rpp.py" "${FILES[@]}" 2>&1)
RC=$?
echo "$OUT" >> "$LOG"

RPPS=$(echo "$OUT" | sed -n 's/^  -> \(.*\.RPP\)  (.*/\1/p')
SUMMARY=$(echo "$OUT" | grep -E '^Converting|->|warning|ERROR' | sed -e 's#^Converting .*/#Converted: #' -e 's#  -> .*/\([^/]*\.RPP\)#  → \1#' | head -40)

if echo "$OUT" | grep -q "No permission to read the folder"; then
  alert "AAF to Reaper" "macOS did not allow the app to read the folder with your audio files, so the project has no audio.

Open System Settings > Privacy & Security > Files and Folders, find \"AAF to Reaper\" and switch on the folder (Desktop, Documents or Downloads). Then convert again.

Tip: folders outside Desktop, Documents and Downloads need no permission."
  exit 1
fi

if [ -z "$RPPS" ]; then
  alert "AAF to Reaper" "Conversion failed.

$SUMMARY

Details are in ~/Library/Logs/AAF to Reaper.log"
  exit 1
fi

CHOICE=$(/usr/bin/osascript - "$SUMMARY" <<'OSA' 2>/dev/null
on run argv
  set r to display dialog (item 1 of argv) with title "AAF to Reaper" buttons {"Done", "Show in Finder", "Open in REAPER"} default button "Open in REAPER"
  return button returned of r
end run
OSA
)
case "$CHOICE" in
  "Open in REAPER")
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      /usr/bin/open -a REAPER "$p" 2>/dev/null || /usr/bin/open -a REAPER64 "$p" 2>/dev/null || /usr/bin/open "$p"
    done <<< "$RPPS" ;;
  "Show in Finder")
    while IFS= read -r p; do [ -n "$p" ] && /usr/bin/open -R "$p"; done <<< "$RPPS" ;;
esac
exit $RC
